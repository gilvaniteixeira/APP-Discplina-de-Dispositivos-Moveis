rules_version = '2';

// Este arquivo vale tanto para o projeto real (firebase deploy) quanto para o
// Emulator Suite local (firebase.json aponta os dois pro mesmo arquivo) — ou
// seja, testar com os emuladores já exercita estas mesmas regras de produção.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
